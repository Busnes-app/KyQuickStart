@@ -0,0 +1,87 @@
+import { posix } from 'node:path';
+import { KyQuickStartRevokeSchema } from 'src/dtos/kyquickstart.dto';
+import z from 'zod';
+
+export const KYQUICKSTART_SERVICE_EMAIL = 'kyquickstart-service@kyquickstart.invalid';
+export const KYQUICKSTART_SERVICE_NAME = 'kyquickstart-service';
+// Exactly what the bridge's Immich target calls: account/directory/creation/access/reactivation routes and provider readback.
+export const KYQUICKSTART_SERVICE_PERMISSIONS = [
+  'adminUser.create',
+  'adminUser.read',
+  'adminUser.update',
+  'systemConfig.read',
+] as const;
+// Native API key secrets are base64 text with non-word characters removed.
+export const KYQUICKSTART_SERVICE_KEY = /^[A-Za-z0-9]{40,64}$/;
+
+const account = z.strictObject({
+  subject: KyQuickStartRevokeSchema.shape.subject,
+  email: z
+    .email()
+    .max(254)
+    .refine((value) => value === value.toLowerCase()),
+  name: z
+    .string()
+    .min(1)
+    .max(255)
+    .regex(/^\P{Cc}+$/u),
+});
+
+export const KyQuickStartSetupSchema = z
+  .strictObject({
+    schema: z.literal('immich.setup/1'),
+    setupId: KyQuickStartRevokeSchema.shape.setupId.refine((value) => value === value.toLowerCase()),
+    provider: z.strictObject({
+      issuer: KyQuickStartRevokeSchema.shape.issuer,
+      clientId: KyQuickStartRevokeSchema.shape.clientId,
+      clientSecret: z
+        .string()
+        .min(1)
+        .max(16_384)
+        .regex(/^\P{Cc}+$/u),
+      rolesClaim: z.string().regex(/^[A-Za-z_][A-Za-z0-9_]{0,63}$/),
+      mobileRedirectUri: z
+        .string()
+        .max(2048)
+        .refine((value) => {
+          if (!URL.canParse(value)) {
+            return false;
+          }
+          const url = new URL(value);
+          return (
+            url.protocol === 'https:' &&
+            !url.username &&
+            !url.password &&
+            !url.search &&
+            !url.hash &&
+            url.pathname === '/api/oauth/mobile-redirect' &&
+            value === `https://${url.host}/api/oauth/mobile-redirect`
+          );
+        }),
+    }),
+    serviceKeyFile: z
+      .string()
+      .max(4096)
+      .refine(
+        (value) =>
+          value.length > 1 && posix.isAbsolute(value) && posix.normalize(value) === value && !value.endsWith('/'),
+      ),
+    administrator: account,
+    everyday: account,
+  })
+  .refine(
+    (value) =>
+      value.administrator.subject !== value.everyday.subject && value.administrator.email !== value.everyday.email,
+  );
+export type KyQuickStartSetup = z.infer<typeof KyQuickStartSetupSchema>;
+
+export const KyQuickStartSetupReceiptSchema = z.strictObject({
+  contract: z.literal('ky.immich-setup/1'),
+  setupId: z.uuid(),
+  intentDigest: z.string().regex(/^[a-f0-9]{64}$/),
+  administratorId: z.uuid(),
+  everydayId: z.uuid(),
+  serviceId: z.uuid(),
+  serviceKeyId: z.uuid(),
+});
+export type KyQuickStartSetupReceipt = z.infer<typeof KyQuickStartSetupReceiptSchema>;
