+        const receipt = KyQuickStartCreationReceiptSchema.parse({
+          contract: 'ky.immich-creation/1',
+          ...binding,
+          profile,
+          userId: user.id,
+          intentDigest: creationIntentDigest({ ...binding, profile }),
+        });
+        await tx
+          .insertInto('user_metadata')
+          .values([
+            { userId: user.id, key: UserMetadataKey.KyQuickStartCreation, value: receipt },
+            {
+              userId: user.id,
+              key: UserMetadataKey.KyQuickStartDirectory,
+              value: {
+                contract: 'ky.immich-directory/1',
+                ...binding,
+                revision: 0,
+                profile: { ...profile, administrator: false },
+              },
+            },
+          ])
+          .execute();
+        return { ...receipt, absent: false };
+      });
+  }
+
+  // Owned-account checks shared by directory projection and reactivation; the fence is returned, not judged.
+  private async ownedKyQuickStartDirectory(tx: Transaction<DB>, userId: string, setupId: string, lock: boolean) {
+    const config = await tx
+      .selectFrom('system_metadata')
+      .select('value')
+      .where('key', '=', SystemMetadataKey.SystemConfig)
+      .$if(lock, (qb) => qb.forUpdate())
+      .executeTakeFirst();
+    const stored = await tx
+      .selectFrom('system_metadata')
+      .select('value')
+      .where('key', '=', SystemMetadataKey.KyQuickStartSetup)
+      .$if(lock, (qb) => qb.forUpdate())
+      .executeTakeFirst();
+    const installation = KyQuickStartSetupReceiptSchema.parse(stored?.value);
+    if (installation.setupId !== setupId) {
+      throw new ConflictException('KyQuickStart directory ownership conflicts');
+    }
+    let created: z.infer<typeof KyQuickStartCreationReceiptSchema> | undefined;
+    if (userId !== installation.administratorId && userId !== installation.everydayId) {
+      const creation = await tx
+        .selectFrom('user_metadata')
+        .select('value')
+        .where('userId', '=', userId)
+        .where('key', '=', UserMetadataKey.KyQuickStartCreation)
+        .executeTakeFirst();
+      created = KyQuickStartCreationReceiptSchema.parse(creation?.value);
+      if (
+        created.setupId !== setupId ||
+        created.userId !== userId ||
+        created.intentDigest !== creationIntentDigest(created)
+      ) {
+        throw new ConflictException('KyQuickStart directory creation ownership conflicts');
+      }
+    }
+    const user = await tx
+      .selectFrom('user')
+      .select(['id', 'oauthId', 'name', 'email', 'isAdmin', 'password', 'deletedAt', 'status'])
+      .where('id', '=', userId)
+      .$if(lock, (qb) => qb.forUpdate())
+      .executeTakeFirstOrThrow();
+    const row = await tx
+      .selectFrom('user_metadata')
+      .select('value')
+      .where('userId', '=', userId)
+      .where('key', '=', UserMetadataKey.KyQuickStartDirectory)
+      .executeTakeFirst();
+    const receipt = KyQuickStartDirectoryReceiptSchema.parse(row?.value);
+    const partial = z.record(z.string(), z.unknown()).parse(config?.value ?? {});
+    const oauth = AdminConfigDto.schema.parse({
+      ...defaults,
+      oauth: { ...defaults.oauth, ...z.record(z.string(), z.unknown()).parse(partial.oauth ?? {}) },
+    }).oauth;
+    if (
+      !oauth.enabled ||
+      oauth.allowInsecureRequests ||
+      oauth.issuerUrl !== receipt.issuer ||
+      oauth.clientId !== receipt.clientId ||
+      receipt.setupId !== setupId ||
+      user.oauthId !== receipt.subject ||
+      (created &&
+        (created.issuer !== receipt.issuer ||
+          created.clientId !== receipt.clientId ||
+          created.subject !== receipt.subject)) ||
+      user.deletedAt !== null ||
+      user.password !== null ||
+      user.status !== UserStatus.Active ||
+      user.name !== receipt.profile.name ||
+      user.email !== receipt.profile.email ||
+      user.isAdmin !== receipt.profile.administrator
+    ) {
+      throw new ConflictException('KyQuickStart directory account conflicts');
+    }
+    const fence = await tx
+      .selectFrom('user_metadata')
+      .select('value')
+      .where('userId', '=', userId)
+      .where('key', '=', UserMetadataKey.KyQuickStartAccess)
+      .executeTakeFirst();
+    return { receipt, fence: fence?.value };
+  }
+
+  async projectKyQuickStartDirectory(
+    userId: string,
+    options: { kind: 'inspect'; setupId: string } | { kind: 'apply'; update: KyQuickStartDirectoryUpdate },
+  ) {
+    if (process.env.IMMICH_CONFIG_FILE) {
+      throw new ConflictException('KyQuickStart directory is unavailable');
+    }
+    const setupId = options.kind === 'inspect' ? options.setupId : options.update.setupId;
+    return this.db
+      .transaction()
+      .setIsolationLevel('serializable')
+      .execute(async (tx) => {
+        const owned = await this.ownedKyQuickStartDirectory(tx, userId, setupId, options.kind === 'apply');
+        let receipt = owned.receipt;
+        const fence = owned.fence;
+        if (options.kind === 'apply') {
+          const update = options.update;
+          if (
+            fence ||
+            update.issuer !== receipt.issuer ||
+            update.clientId !== receipt.clientId ||
+            update.subject !== receipt.subject ||
+            update.expectedRevision !== receipt.revision
+          ) {
+            throw new ConflictException('KyQuickStart directory update conflicts');
+          }
+          if (!isDeepStrictEqual(update.profile, receipt.profile)) {
+            receipt = { ...receipt, revision: receipt.revision + 1, profile: update.profile };
+            await tx
+              .updateTable('user')
+              .set({
+                name: update.profile.name,
+                email: update.profile.email,
+                isAdmin: update.profile.administrator,
+                updatedAt: new Date(),
+              })
+              .where('id', '=', userId)
+              .execute();
+            await tx
+              .updateTable('user_metadata')
+              .set({ value: receipt })
+              .where('userId', '=', userId)
+              .where('key', '=', UserMetadataKey.KyQuickStartDirectory)
+              .execute();
+          }
+        }
+        return { ...receipt, userId, revoked: Boolean(fence) };
+      });
+  }
+
+  async reactivateKyQuickStartAccess(userId: string, dto: KyQuickStartReactivate) {
+    if (process.env.IMMICH_CONFIG_FILE) {
+      throw new ConflictException('KyQuickStart reactivation is unavailable');
+    }
+    return this.db
+      .transaction()
+      .setIsolationLevel('serializable')
+      .execute(async (tx) => {
+        const owned = await this.ownedKyQuickStartDirectory(tx, userId, dto.setupId, true);
+        const fence = owned.fence === undefined ? undefined : KyQuickStartFenceSchema.safeParse(owned.fence);
+        // The stored fence, else the directory receipt, pins the exact binding, as for revocation.
+        const pin = fence ? (fence.success ? fence.data : undefined) : owned.receipt;
+        const row = await tx
+          .selectFrom('user_metadata')
+          .select('value')
+          .where('userId', '=', userId)
+          .where('key', '=', UserMetadataKey.KyQuickStartReactivation)
+          .executeTakeFirst();
+        const stored = row === undefined ? undefined : KyQuickStartReactivationSchema.safeParse(row.value);
+        if (
+          !pin ||
+          pin.setupId !== dto.setupId ||
+          pin.issuer !== dto.issuer ||
+          pin.clientId !== dto.clientId ||
+          pin.subject !== dto.subject ||
+          (stored && !stored.success)
+        ) {
+          throw new ConflictException('KyQuickStart reactivation ownership conflicts');
+        }
+        const previous = stored?.data;
+        if (!fence) {
+          // Only an exact repeat of the committed reactivation is accepted without a fence.
+          if (!previous || previous.epoch !== dto.epoch || !isDeepStrictEqual(owned.receipt.profile, dto.profile)) {
+            throw new ConflictException('KyQuickStart reactivation conflicts');
+          }
+          return previous;
+        }
+        if (!fence.success || (previous && dto.epoch <= previous.epoch)) {
+          throw new ConflictException('KyQuickStart reactivation conflicts');
+        }
+        // Authority first, then the fence clears; no session or key is restored.
+        if (!isDeepStrictEqual(owned.receipt.profile, dto.profile)) {
+          const collision = await tx
+            .selectFrom('user')
+            .select('id')
+            .where('email', '=', dto.profile.email)
+            .where('id', '!=', userId)
+            .executeTakeFirst();
+          if (collision) {
+            throw new ConflictException('KyQuickStart reactivation email is already retained');
+          }
+          await tx
+            .updateTable('user')
+            .set({
+              name: dto.profile.name,
+              email: dto.profile.email,
+              isAdmin: dto.profile.administrator,
+              updatedAt: new Date(),
+            })
+            .where('id', '=', userId)
+            .execute();
+          await tx
+            .updateTable('user_metadata')
+            .set({ value: { ...owned.receipt, revision: owned.receipt.revision + 1, profile: dto.profile } })
+            .where('userId', '=', userId)
+            .where('key', '=', UserMetadataKey.KyQuickStartDirectory)
+            .execute();
+        }
+        // Any credential that exists while fenced is invalid (an in-flight race); it dies before the fence lifts.
+        const sessions = await tx.deleteFrom('session').where('userId', '=', userId).executeTakeFirst();
+        const apiKeys = await tx.deleteFrom('api_key').where('userId', '=', userId).executeTakeFirst();
+        await tx
+          .deleteFrom('user_metadata')
+          .where('userId', '=', userId)
+          .where('key', '=', UserMetadataKey.KyQuickStartAccess)
+          .execute();
+        const reactivation = KyQuickStartReactivationSchema.parse({
+          contract: 'ky.immich-reactivation/1',
+          setupId: dto.setupId,
+          epoch: dto.epoch,
+          reactivatedAt: new Date().toISOString(),
+          revokedAt: fence.data.revokedAt,
+          deletedSessions: Number(sessions.numDeletedRows),
+          deletedApiKeys: Number(apiKeys.numDeletedRows),
+        });
+        await tx
+          .insertInto('user_metadata')
+          .values({ userId, key: UserMetadataKey.KyQuickStartReactivation, value: reactivation })
+          .onConflict((oc) => oc.columns(['userId', 'key']).doUpdateSet({ value: reactivation }))
+          .execute();
+        return reactivation;
+      });
+  }
