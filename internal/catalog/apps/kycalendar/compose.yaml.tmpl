# Docker variant of this product's pinned manifest; bind data belongs to the SSH user.
services:
  app:
    image: {{ .Images.kycalendar }}
    platform: linux/amd64
    user: "${KYQ_UID:?}:${KYQ_GID:?}"
    restart: unless-stopped
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    read_only: true
    tmpfs: [/tmp]
    mem_limit: 512m
    memswap_limit: 512m
    cpus: 1
    pids_limit: 128
    stop_grace_period: 1200s
    ports: ["{{forward}}:8080"]
    environment:
      KY_HOST: "0.0.0.0"
      KY_PORT: "8080"
      KY_APP_NAME: "KyCalendar"
      KY_APP_URL: "https://{{host}}"
      # Forwarded headers only from the edge's own address; none without the edge's egress_address.
      KY_TRUSTED_PROXIES: "{{edge_prefix}}"
      KY_DB_DRIVER: "sqlite"
      KY_DATA_DIR: "/app/data"
      KY_SSO_ENABLED: "true"
      KY_SSO_AUTO_PROVISION: "false"
      KYCALENDAR_BACKUP_DIR: "/app/backups"
      KYCALENDAR_BACKUP_KEEP: "7"
      KYCALENDAR_BACKUP_DEPOSIT_INTERVAL: "24h"
      GOMEMLIMIT: "384MiB"
    volumes:
      - "./data:/app/data"
      - "./backups:/app/backups"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/api/installer/network"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 10s
