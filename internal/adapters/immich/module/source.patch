+          .select('value')
+          .where('userId', '=', userId)
+          .where('key', '=', UserMetadataKey.KyQuickStartDirectory)
+          .executeTakeFirst();
+        let receipt = KyQuickStartDirectoryReceiptSchema.parse(row?.value);
