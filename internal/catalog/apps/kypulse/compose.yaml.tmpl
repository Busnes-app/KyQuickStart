# Docker variant of this product's pinned manifest; bind data belongs to the SSH user.
services:
  app:
    image: {{ .Images.kypulse }}
    platform: linux/amd64
    user: "${KYQ_UID:?}:${KYQ_GID:?}"
    restart: unless-stopped
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    read_only: true
    tmpfs: [/tmp]
    mem_limit: 512m
    memswap_limit: 512m
    cpus: 1
    pids_limit: 128
    stop_grace_period: 60s
    ports: ["{{forward}}:8080"]
    environment:
      KYPULSE_ENV: "production"
      KYPULSE_HOST: "0.0.0.0"
      KYPULSE_PORT: "8080"
      KYPULSE_APP_URL: "https://{{host}}"
      # Forwarded headers only from the edge's own address; none without the edge's egress_address.
      KYPULSE_TRUSTED_PROXIES: "{{edge_prefix}}"
      KYPULSE_BACKUP_ALLOW_PRIVATE_RECOVERY: "{{private_recovery}}"
      KYPULSE_DATA_DIR: "/app/data"
      KYPULSE_AUDIT_KEY_FILE: "/app/secrets/audit.key"
      KYPULSE_SSO_AUTO_PROVISION: "false"
      GOMEMLIMIT: "384MiB"
    volumes:
      - "./data:/app/data"
      - "./secrets:/app/secrets"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 10s
