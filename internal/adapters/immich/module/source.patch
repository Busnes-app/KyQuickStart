+import { createZodDto } from 'nestjs-zod';
+import z from 'zod';
+
+const visible = z
+  .string()
+  .min(1)
+  .max(255)
+  .regex(/^[\u{21}-\u{7E}]+$/u);
+export const KyQuickStartRevokeSchema = z.strictObject({
+  setupId: z.uuid(),
+  issuer: z
+    .string()
+    .min(1)
+    .max(2048)
+    .refine((value) => {
+      if (!URL.canParse(value)) {
+        return false;
+      }
+      const url = new URL(value);
+      return (
+        url.protocol === 'https:' &&
+        !url.username &&
+        !url.password &&
+        !url.search &&
+        !url.hash &&
+        !/[\s\\]/.test(value) &&
+        !value.includes('?') &&
+        !value.includes('#')
+      );
+    }),
+  clientId: visible,
+  subject: visible,
+});
+
+export class KyQuickStartRevokeDto extends createZodDto(KyQuickStartRevokeSchema) {}
+
+export const KyQuickStartFenceSchema = KyQuickStartRevokeSchema.extend({
+  contract: z.literal('ky.immich-access/1'),
+  revokedAt: z.iso.datetime(),
+});
+export type KyQuickStartFence = z.infer<typeof KyQuickStartFenceSchema>;
+
+export const KyQuickStartDirectoryProfileSchema = z.strictObject({
+  name: z
+    .string()
+    .min(1)
+    .max(255)
+    .regex(/^\P{Cc}+$/u),
+  email: z
+    .email()
+    .max(254)
+    .refine((value) => value === value.toLowerCase()),
+  administrator: z.boolean(),
+});
+export const KyQuickStartDirectoryReceiptSchema = KyQuickStartRevokeSchema.extend({
+  contract: z.literal('ky.immich-directory/1'),
+  revision: z.number().int().min(0).max(Number.MAX_SAFE_INTEGER),
+  profile: KyQuickStartDirectoryProfileSchema,
+});
+export const KyQuickStartDirectoryUpdateSchema = KyQuickStartRevokeSchema.extend({
+  expectedRevision: z
+    .number()
+    .int()
+    .min(0)
+    .max(Number.MAX_SAFE_INTEGER - 1),
+  profile: KyQuickStartDirectoryProfileSchema,
+});
+export class KyQuickStartDirectoryUpdateDto extends createZodDto(KyQuickStartDirectoryUpdateSchema) {}
+export class KyQuickStartDirectoryQueryDto extends createZodDto(z.strictObject({ setupId: z.uuid() })) {}
+export type KyQuickStartDirectoryUpdate = z.infer<typeof KyQuickStartDirectoryUpdateSchema>;
+
+export const KyQuickStartCreationSchema = KyQuickStartRevokeSchema.extend({
+  profile: KyQuickStartDirectoryProfileSchema.pick({ name: true, email: true }),
+});
+export const KyQuickStartCreationReceiptSchema = KyQuickStartCreationSchema.extend({
+  contract: z.literal('ky.immich-creation/1'),
+  userId: z.uuid(),
+  intentDigest: z.string().regex(/^[a-f0-9]{64}$/),
+});
+export type KyQuickStartCreation = z.infer<typeof KyQuickStartCreationSchema>;
+export class KyQuickStartCreationDto extends createZodDto(KyQuickStartCreationSchema) {}
+export class KyQuickStartCreationQueryDto extends createZodDto(KyQuickStartRevokeSchema) {}
