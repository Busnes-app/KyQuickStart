# Docker variant of this product's pinned manifest; bind data belongs to the SSH user.
services:
  app:
    image: {{ .Images.kynotes }}
    platform: linux/amd64
    user: "${KYQ_UID:?}:${KYQ_GID:?}"
    restart: unless-stopped
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    read_only: true
    tmpfs: [/tmp]
    mem_limit: 512m
    memswap_limit: 512m
    cpus: 1
    pids_limit: 128
    stop_grace_period: 1020s
    ports: ["{{forward}}:8080"]
    environment:
      PORT: "8080"
      KYNOTES_DATA_DIR: "/data"
      # Forwarded headers only from the edge's own address; none without the edge's egress_address.
      KYNOTES_SERVER_TRUSTED_PROXIES: "{{edge_prefix}}"
      KYNOTES_BACKUP_ALLOW_PRIVATE_RECOVERY: "{{private_recovery}}"
      KYNOTES_BACKUP_DIR: "/backups"
      KYNOTES_BACKUP_KEEP: "7"
      KYNOTES_BACKUP_DEPOSIT_INTERVAL: "24h"
      GOMEMLIMIT: "384MiB"
    volumes:
      - "./data:/data"
      - "./backups:/backups"
    healthcheck:
      test: ["CMD", "/kynotes-server", "healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 10s
