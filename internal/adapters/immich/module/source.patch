+  }
+
+  async updateKyQuickStartDirectory(auth: AuthDto, id: string, update: KyQuickStartDirectoryUpdateDto) {
+    if (!auth.apiKey || auth.user.id === id) {
+      throw new ForbiddenException('KyQuickStart requires a separate administrator API key');
+    }
+    try {
+      return await this.systemMetadataRepository.projectKyQuickStartDirectory(id, { kind: 'apply', update });
+    } catch {
+      throw new ConflictException('KyQuickStart directory update requires reconciliation');
+    }
+  }
+
+  async inspectKyQuickStartAccess(auth: AuthDto, id: string) {
+    if (!auth.apiKey) {
+      throw new ForbiddenException('KyQuickStart requires an administrator API key');
+    }
+    // Revocation must survive disabled OIDC, issuer rotation and soft deletion, so the
+    // stored fence or directory receipt pins the provider. Only unowned accounts use live config.
+    const user = await this.findOrFail(id, { withDeleted: true });
+    const state = await this.userRepository.inspectKyQuickStartAccess(id);
+    let pin: { issuer: string; clientId: string; subject: string } | null = state.fence ?? state.directory;
+    if (!pin) {
+      const { oauth } = await this.getConfig({ withCache: false });
+      pin = { issuer: oauth.issuerUrl, clientId: oauth.clientId, subject: user.oauthId };
+    }
+    if (!user.oauthId || pin.subject !== user.oauthId) {
+      throw new ForbiddenException('KyQuickStart provider or account binding conflicts');
+    }
+    return {
+      contract: 'ky.immich-access/1',
+      userId: id,
+      issuer: pin.issuer,
+      clientId: pin.clientId,
+      subject: user.oauthId,
+      setupId: state.fence?.setupId ?? null,
+      revokedAt: state.fence?.revokedAt ?? null,
+      revoked: state.fence !== null,
+      reactivation: state.reactivation
+        ? {
+            epoch: state.reactivation.epoch,
+            reactivatedAt: state.reactivation.reactivatedAt,
+            deletedSessions: state.reactivation.deletedSessions,
+            deletedApiKeys: state.reactivation.deletedApiKeys,
+          }
+        : null,
+      apiKeys: state.apiKeys,
+      sessions: state.sessions,
+    };
+  }
+
+  async revokeKyQuickStartAccess(auth: AuthDto, id: string, dto: KyQuickStartRevokeDto) {
+    const state = await this.inspectKyQuickStartAccess(auth, id);
+    if (
+      auth.user.id === id ||
+      state.issuer !== dto.issuer ||
+      state.clientId !== dto.clientId ||
+      state.subject !== dto.subject
+    ) {
+      throw new ForbiddenException('KyQuickStart revocation binding conflicts');
+    }
+    await this.userRepository.revokeKyQuickStartAccess(id, dto);
+    this.websocketRepository.disconnectUser(id);
+    return this.inspectKyQuickStartAccess(auth, id);
+  }
+
+  async reactivateKyQuickStartAccess(auth: AuthDto, id: string, dto: KyQuickStartReactivateDto) {
+    const state = await this.inspectKyQuickStartAccess(auth, id);
+    if (
+      auth.user.id === id ||
+      state.issuer !== dto.issuer ||
+      state.clientId !== dto.clientId ||
+      state.subject !== dto.subject
+    ) {
+      throw new ForbiddenException('KyQuickStart reactivation binding conflicts');
+    }
+    try {
+      await this.systemMetadataRepository.reactivateKyQuickStartAccess(id, dto);
+    } catch (error) {
+      if (error instanceof ConflictException || error instanceof ZodError) {
+        throw new ConflictException('KyQuickStart reactivation conflicts');
+      }
+      // A database commit may have succeeded before its acknowledgment was lost.
+      throw new ServiceUnavailableException('KyQuickStart reactivation requires outcome reconciliation');
+    }
+    this.logger.log(`KyQuickStart reactivated user ${id} at epoch ${dto.epoch}`);
+    return this.inspectKyQuickStartAccess(auth, id);
+  }
