@@ -0,0 +1,191 @@
+import { Command, CommandRunner, Option } from 'nest-commander';
+import { randomBytes } from 'node:crypto';
+import { constants } from 'node:fs';
+import { FileHandle, lstat, open, realpath } from 'node:fs/promises';
+import { dirname, isAbsolute, resolve } from 'node:path';
+import { KYQUICKSTART_SERVICE_KEY, KyQuickStartSetupSchema } from 'src/dtos/kyquickstart-setup.dto';
+import { ConfigRepository } from 'src/repositories/config.repository';
+import { SystemMetadataRepository } from 'src/repositories/system-metadata.repository';
+
+// Absolute canonical path beneath root/user-owned nonsymlink parents without group/other write.
+async function protectedParents(path: string) {
+  if (!isAbsolute(path) || resolve(path) !== path) {
+    throw new Error('Protected path unavailable');
+  }
+  let parent = dirname(path);
+  if ((await realpath(parent)) !== parent) {
+    throw new Error('Protected path unavailable');
+  }
+  while (true) {
+    const info = await lstat(parent);
+    if (
+      !info.isDirectory() ||
+      info.isSymbolicLink() ||
+      (info.mode & 0o022) !== 0 ||
+      (info.uid !== 0 && info.uid !== process.getuid?.())
+    ) {
+      throw new Error('Protected parent unavailable');
+    }
+    if (parent === '/') {
+      return;
+    }
+    parent = dirname(parent);
+  }
+}
+
+// A regular 0600 file owned by the command user, read without following links.
+async function readPrivate(path: string, max: number): Promise<Buffer> {
+  await protectedParents(path);
+  const file = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW);
+  try {
+    const info = await file.stat();
+    if (
+      !info.isFile() ||
+      (info.mode & 0o777) !== 0o600 ||
+      info.uid !== process.getuid?.() ||
+      info.size === 0 ||
+      info.size > max
+    ) {
+      throw new Error('File is not private');
+    }
+    const data = Buffer.alloc(max + 1);
+    const read = await file.read(data, 0, data.length, 0);
+    if (read.bytesRead !== info.size) {
+      throw new Error('File changed during read');
+    }
+    return data.subarray(0, read.bytesRead);
+  } finally {
+    await file.close();
+  }
+}
+
+async function readServiceKey(path: string): Promise<string> {
+  const data = await readPrivate(path, 64);
+  const key = data.toString('ascii');
+  if (!KYQUICKSTART_SERVICE_KEY.test(key)) {
+    throw new Error('Service key file is invalid');
+  }
+  return key;
+}
+
+// Reuse a key a crashed run left before its commit; otherwise create it exclusively and durably.
+async function ensureServiceKey(path: string): Promise<string> {
+  await protectedParents(path);
+  const key = randomBytes(32).toString('base64').replaceAll(/\W/g, '');
+  let file: FileHandle;
+  try {
+    file = await open(path, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW, 0o600);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'EEXIST') {
+      return readServiceKey(path);
+    }
+    throw error;
+  }
+  try {
+    await file.writeFile(key);
+    await file.sync();
+  } finally {
+    await file.close();
+  }
+  const directory = await open(dirname(path), constants.O_RDONLY | constants.O_DIRECTORY);
+  try {
+    await directory.sync();
+  } finally {
+    await directory.close();
+  }
+  return readServiceKey(path);
+}
+
+@Command({ name: 'apply-setup', description: 'Apply a protected KyQuickStart installation bundle' })
+export class KyQuickStartSetupCommand extends CommandRunner {
+  constructor(
+    private metadata: SystemMetadataRepository,
+    private config: ConfigRepository,
+  ) {
+    super();
+  }
+
+  @Option({ flags: '--file <path>' })
+  file(value: string) {
+    return value;
+  }
+
+  @Option({ flags: '--capabilities' })
+  capabilities() {
+    return true;
+  }
+
+  @Option({ flags: '--check' })
+  check() {
+    return true;
+  }
+
+  @Option({ flags: '--resume' })
+  resume() {
+    return true;
+  }
+
+  async run(
+    _args: string[],
+    options: { file?: string; capabilities?: boolean; check?: boolean; resume?: boolean },
+  ): Promise<void> {
+    try {
+      if (options.capabilities) {
+        if (options.file || options.check || options.resume) {
+          throw new Error('Conflicting capability flags');
+        }
+        process.stdout.write(
+          `${JSON.stringify({
+            schema: 'ky.setup-capabilities/1',
+            service: 'immich',
+            bundleSchema: 'immich.setup/1',
+            nativeVersion: '3.2.0',
+            moduleContract: 'ky.immich-setup/1',
+            features: [
+              'native-oidc',
+              'owned-initial-accounts',
+              'immutable-receipts',
+              'check',
+              'mobile-redirect',
+              'service-administrator',
+              'reactivation',
+            ],
+          })}\n`,
+        );
+        return;
+      }
+      if (!options.file || this.config.getEnv().configFile) {
+        throw new Error('Protected bundle required');
+      }
+      const data = await readPrivate(options.file, 65_536);
+      const spec = KyQuickStartSetupSchema.parse(JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(data)));
+      if (spec.serviceKeyFile === options.file) {
+        throw new Error('Service key file conflicts with the bundle');
+      }
+      // After commit the key file must already hold the stored key. Before commit,
+      // the file is written (or a crash-left file reused) before the database commit.
+      const serviceKey = (await this.metadata.hasKyQuickStartSetup())
+        ? await readServiceKey(spec.serviceKeyFile)
+        : options.check || options.resume
+          ? undefined
+          : await ensureServiceKey(spec.serviceKeyFile);
+      const report = await this.metadata.applyKyQuickStartSetup(spec, serviceKey, {
+        check: options.check === true,
+        resume: options.resume === true,
+      });
+      if (!options.check) {
+        const proof = await this.metadata.applyKyQuickStartSetup(spec, await readServiceKey(spec.serviceKeyFile), {
+          check: true,
+          resume: true,
+        });
+        report.accounts = proof.accounts;
+        report.service = proof.service;
+        report.nativeUsers = proof.nativeUsers;
+      }
+      process.stdout.write(`${JSON.stringify(report)}\n`);
+    } catch {
+      process.stderr.write('Immich setup refused; inspect protected intent and native ownership.\n');
+      process.exitCode = 1;
+    }
+  }
+}
