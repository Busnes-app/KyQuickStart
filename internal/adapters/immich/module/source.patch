+import { UnauthorizedException } from '@nestjs/common';
+import { createServer } from 'node:http';
+import { OAuthTokenEndpointAuthMethod } from 'src/enum';
+import { LoggingRepository } from 'src/repositories/logging.repository';
+import { OAuthRepository } from 'src/repositories/oauth.repository';
+
+describe('OAuth grant refusal', () => {
+  it.each([
+    { error: 'invalid_grant', status: 400, denied: true },
+    { error: 'access_denied', status: 403, denied: true },
+    { error: 'invalid_client', status: 401, denied: false },
+    { error: 'invalid_grant', status: 503, denied: false },
+    { error: 'transport', status: 0, denied: false },
+  ])('classifies $error HTTP $status using the real OAuth client', async ({ error, status, denied }) => {
+    const logger = LoggingRepository.create();
+    const logged = vi.spyOn(logger, 'error').mockImplementation(() => {});
+    let issuer = '';
+    const server = createServer((request, response) => {
+      response.setHeader('Content-Type', 'application/json');
+      if (request.url === '/.well-known/openid-configuration') {
+        response.end(
+          JSON.stringify({
+            issuer,
+            authorization_endpoint: `${issuer}/authorize`,
+            token_endpoint: `${issuer}/token`,
+            jwks_uri: `${issuer}/jwks`,
+            response_types_supported: ['code'],
+            subject_types_supported: ['public'],
+            id_token_signing_alg_values_supported: ['RS256'],
+            code_challenge_methods_supported: ['S256'],
+          }),
+        );
+      } else if (error === 'transport') {
+        request.socket.destroy();
+      } else {
+        response.statusCode = status;
+        response.end(JSON.stringify({ error, error_description: 'private grant diagnostic' }));
+      }
+    });
+    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+    const address = server.address();
+    if (!address || typeof address === 'string') {
+      throw new Error('Owned OAuth fixture address missing');
+    }
+    issuer = `http://127.0.0.1:${address.port}`;
+    try {
+      const repository = new OAuthRepository(logger);
+      const operation = repository.getProfileAndOAuthSid(
+        {
+          accountManagementUrl: '',
+          endSessionEndpoint: '',
+          mobileOverrideEnabled: false,
+          mobileRedirectUri: '',
+          profileSigningAlgorithm: 'none',
+          prompt: '',
+          scope: 'openid profile email',
+          signingAlgorithm: 'RS256',
+          tokenEndpointAuthMethod: OAuthTokenEndpointAuthMethod.ClientSecretPost,
+          clientId: 'owned-client',
+          clientSecret: 'owned-secret',
+          issuerUrl: issuer,
+          allowInsecureRequests: true,
+          timeout: 1,
+        },
+        `${issuer}/callback?code=owned-code&state=owned-state`,
+        'owned-state',
+        'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',
+      );
+      if (denied) {
+        await expect(operation).rejects.toBeInstanceOf(UnauthorizedException);
+        expect(logged).not.toHaveBeenCalled();
+      } else {
+        await expect(operation).rejects.toThrow('OAuth login failed');
+        expect(logged).toHaveBeenCalledOnce();
+      }
+    } finally {
+      server.closeAllConnections();
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+      logged.mockRestore();
+    }
+  });
+});
