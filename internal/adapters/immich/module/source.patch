+import { Command, CommandRunner, Option } from 'nest-commander';
+import { constants } from 'node:fs';
+import { lstat, open, realpath } from 'node:fs/promises';
+import { dirname, isAbsolute, resolve } from 'node:path';
+import { KyQuickStartSetupSchema } from 'src/dtos/kyquickstart-setup.dto';
+import { ConfigRepository } from 'src/repositories/config.repository';
+import { SystemMetadataRepository } from 'src/repositories/system-metadata.repository';
+
+@Command({ name: 'apply-setup', description: 'Apply a protected KyQuickStart installation bundle' })
+export class KyQuickStartSetupCommand extends CommandRunner {
+  constructor(
+    private metadata: SystemMetadataRepository,
+    private config: ConfigRepository,
+  ) {
+    super();
+  }
+
+  @Option({ flags: '--file <path>' })
+  file(value: string) {
+    return value;
+  }
+
+  @Option({ flags: '--capabilities' })
+  capabilities() {
+    return true;
+  }
+
+  @Option({ flags: '--check' })
+  check() {
+    return true;
+  }
+
+  @Option({ flags: '--resume' })
+  resume() {
+    return true;
+  }
+
+  async run(
+    _args: string[],
+    options: { file?: string; capabilities?: boolean; check?: boolean; resume?: boolean },
+  ): Promise<void> {
+    try {
+      if (options.capabilities) {
+        if (options.file || options.check || options.resume) {
+          throw new Error('Conflicting capability flags');
+        }
+        process.stdout.write(
+          `${JSON.stringify({
+            schema: 'ky.setup-capabilities/1',
+            service: 'immich',
+            bundleSchema: 'immich.setup/1',
+            nativeVersion: '3.2.0',
+            moduleContract: 'ky.immich-setup/1',
+            features: ['native-oidc', 'owned-initial-accounts', 'immutable-receipts', 'check'],
+          })}\n`,
+        );
+        return;
+      }
+      if (!options.file) {
+        throw new Error('Protected bundle required');
+      }
+      if (
+        !isAbsolute(options.file) ||
+        resolve(options.file) !== options.file ||
+        (await realpath(options.file)) !== options.file ||
+        this.config.getEnv().configFile
+      ) {
+        throw new Error('Protected bundle path unavailable');
+      }
+      let parent = dirname(options.file);
+      while (true) {
+        const info = await lstat(parent);
+        if (
+          !info.isDirectory() ||
+          info.isSymbolicLink() ||
+          (info.mode & 0o022) !== 0 ||
+          (info.uid !== 0 && info.uid !== process.getuid?.())
+        ) {
+          throw new Error('Bundle parent is not protected');
+        }
+        if (parent === '/') {
+          break;
+        }
+        parent = dirname(parent);
+      }
+      const file = await open(options.file, constants.O_RDONLY | constants.O_NOFOLLOW);
+      let data: Buffer;
+      try {
+        const info = await file.stat();
+        if (
+          !info.isFile() ||
+          (info.mode & 0o777) !== 0o600 ||
+          info.uid !== process.getuid?.() ||
+          info.size === 0 ||
+          info.size > 65_536
+        ) {
+          throw new Error('Bundle is not private');
+        }
+        data = Buffer.alloc(65_537);
+        const read = await file.read(data, 0, data.length, 0);
+        if (read.bytesRead !== info.size) {
+          throw new Error('Bundle changed during read');
+        }
+        data = data.subarray(0, read.bytesRead);
+      } finally {
+        await file.close();
+      }
+      const spec = KyQuickStartSetupSchema.parse(JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(data)));
+      const report = await this.metadata.applyKyQuickStartSetup(spec, {
+        check: options.check === true,
+        resume: options.resume === true,
+      });
+      if (!options.check) {
+        const proof = await this.metadata.applyKyQuickStartSetup(spec, { check: true, resume: true });
+        report.accounts = proof.accounts;
+      }
+      process.stdout.write(`${JSON.stringify(report)}\n`);
+    } catch {
+      process.stderr.write('Immich setup refused; inspect protected intent and native ownership.\n');
+      process.exitCode = 1;
+    }
+  }
+}
