# From Immich v3.2.0's docker/docker-compose.yml. Every service runs as the target user with
# no capabilities. The database and cache are reachable only on the internal network; the
# server publishes the one port the edge forwards to, the bridge its TLS port beside it.
services:
  immich-server:
    image: {{ .Images.server }}
    platform: linux/amd64
    user: "${KYQ_UID:?}:${KYQ_GID:?}"
    restart: unless-stopped
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    mem_limit: 2g
    memswap_limit: 2g
    cpus: 2
    pids_limit: 512
    ports: ["{{forward}}:2283"]
    secrets: [db_password]
    environment:
      DB_HOSTNAME: database
      DB_USERNAME: postgres
      DB_DATABASE_NAME: immich
      DB_PASSWORD_FILE: /run/secrets/db_password
      REDIS_HOSTNAME: redis
      IMMICH_MACHINE_LEARNING_URL: http://immich-machine-learning:3003
    # library is the whole /data tree; setup holds the setup bundle and the service key.
    volumes: ["./library:/data", "./setup:/kyq-setup"]
    tmpfs: [/tmp]
    networks: [default, internal]
    depends_on:
      database: {condition: service_healthy}
      redis: {condition: service_healthy}
    healthcheck:
      test: ["CMD", "immich-healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 300s
      start_interval: 2s
  immich-machine-learning:
    image: {{ .Images.machine_learning }}
    platform: linux/amd64
    user: "${KYQ_UID:?}:${KYQ_GID:?}"
    restart: unless-stopped
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    mem_limit: 3g
    memswap_limit: 3g
    cpus: 2
    pids_limit: 256
    # Models download here on first use (Hugging Face); not backed up.
    volumes: ["./model-cache:/cache"]
    tmpfs: [/tmp]
    # Egress for model downloads; no route to the database or cache.
    networks: [default]
    healthcheck:
      test: ["CMD", "python3", "healthcheck.py"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 120s
      start_interval: 2s
  database:
    image: {{ .Images.postgres }}
    user: "${KYQ_UID:?}:${KYQ_GID:?}"
    restart: unless-stopped
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    mem_limit: 1g
    memswap_limit: 1g
    cpus: 2
    pids_limit: 256
    shm_size: 128mb
    secrets: [db_password]
    environment:
      POSTGRES_USER: postgres
      POSTGRES_DB: immich
      POSTGRES_PASSWORD_FILE: /run/secrets/db_password
      POSTGRES_INITDB_ARGS: --data-checksums
    volumes: ["./postgres:/var/lib/postgresql/data"]
    tmpfs: [/var/run/postgresql, /tmp]
    networks: [internal]
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres", "-d", "immich"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 120s
      start_interval: 2s
  redis:
    image: {{ .Images.valkey }}
    user: "${KYQ_UID:?}:${KYQ_GID:?}"
    restart: unless-stopped
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    read_only: true
    mem_limit: 256m
    memswap_limit: 256m
    cpus: 1
    pids_limit: 64
    # A job queue Immich refills; nothing persists.
    command: [valkey-server, --save, "", --appendonly, "no"]
    tmpfs: [/data]
    networks: [internal]
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 2s
  directory:
    image: {{ .Images.directory }}
    user: "${KYQ_UID:?}:${KYQ_GID:?}"
    restart: unless-stopped
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    read_only: true
    mem_limit: 128m
    memswap_limit: 128m
    cpus: 1
    pids_limit: 64
    # The edge forwards /scim/immich here over TLS; KyIdentity verifies the edge's certificate.
    ports: ["{{bridge_forward}}:8443"]
    # config: runtime file, TLS and tokens; state: bindings, jobs and audit.
    volumes: ["./directory:/directory"]
    command: [--config, /directory/config/runtime.json]
    networks: [default, internal]
    depends_on:
      immich-server: {condition: service_healthy}
    healthcheck:
      test: ["CMD", "kyoffboard", "--config", "/directory/config/runtime.json", "--healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
      start_interval: 2s
networks:
  internal:
    internal: true
secrets:
  db_password:
    file: ./secrets/db_password
